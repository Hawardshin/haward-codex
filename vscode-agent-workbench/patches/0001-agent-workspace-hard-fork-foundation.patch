+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+
+type TimelineNode = {
+	readonly label: string;
+	readonly description: string;
+	readonly detail: string;
+	readonly icon: vscode.ThemeIcon;
+};
+
+class AgentWorkspaceTimelineProvider implements vscode.TreeDataProvider<TimelineNode> {
+
+	private readonly _onDidChangeTreeData = new vscode.EventEmitter<TimelineNode | undefined>();
+	readonly onDidChangeTreeData = this._onDidChangeTreeData.event;
+
+	refresh(): void {
+		this._onDidChangeTreeData.fire(undefined);
+	}
+
+	getTreeItem(element: TimelineNode): vscode.TreeItem {
+		const item = new vscode.TreeItem(element.label, vscode.TreeItemCollapsibleState.None);
+		item.description = element.description;
+		item.tooltip = element.detail;
+		item.iconPath = element.icon;
+		return item;
+	}
+
+	getChildren(): TimelineNode[] {
+		const workspaceFolders = vscode.workspace.workspaceFolders ?? [];
+		const platformRoot = vscode.workspace.getConfiguration('agentWorkspace').get<string>('platformRoot') ?? '';
+		const primaryWorkspace = workspaceFolders[0]?.uri.fsPath ?? 'No workspace folder open';
+
+		return [
+			{
+				label: 'Workspace root',
+				description: primaryWorkspace,
+				detail: 'Primary folder currently opened in Agent Workspace Code.',
+				icon: new vscode.ThemeIcon('root-folder')
+			},
+			{
+				label: 'Platform root',
+				description: platformRoot || 'Set agentWorkspace.platformRoot',
+				detail: 'Connect this hard fork to the Agent Workspace Platform repository.',
+				icon: new vscode.ThemeIcon('server-environment')
+			},
+			{
+				label: 'Hard-fork lane',
+				description: 'Code - OSS source + Agent Workspace surface',
+				detail: 'This lane keeps VS Code workspace primitives while adding agent platform controls.',
+				icon: new vscode.ThemeIcon('git-branch')
+			}
+		];
+	}
+}
+
+export function activate(context: vscode.ExtensionContext): void {
+	const provider = new AgentWorkspaceTimelineProvider();
+	context.subscriptions.push(vscode.window.registerTreeDataProvider('agentWorkspace.timeline', provider));
+	context.subscriptions.push(vscode.commands.registerCommand('agentWorkspace.refresh', () => provider.refresh()));
+	context.subscriptions.push(vscode.commands.registerCommand('agentWorkspace.openPlatformStatus', () => {
+		void vscode.window.showInformationMessage('Agent Workspace is wired into this Code - OSS hard fork. Set agentWorkspace.platformRoot to connect the platform repository.');
+	}));
+}
