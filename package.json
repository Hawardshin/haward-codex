{
  "name": "haward-codex-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for the personal agent-building platform.",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "monitor:build": "corepack pnpm --filter workspace-monitor build",
    "monitor:check": "corepack pnpm --filter workspace-monitor check",
    "monitor:test": "corepack pnpm --filter workspace-monitor test",
    "desktop:check": "corepack pnpm --filter platform-desktop-app check",
    "desktop:test": "corepack pnpm --filter platform-desktop-app test",
    "desktop:setup": "corepack pnpm --filter platform-desktop-app run setup",
    "desktop:setup:verify": "corepack pnpm --filter platform-desktop-app run setup && corepack pnpm --filter platform-desktop-app run verify",
    "desktop:verify:quick": "corepack pnpm --filter platform-desktop-app run verify:quick",
    "desktop:verify": "corepack pnpm --filter platform-desktop-app run verify",
    "desktop:renderer:build": "corepack pnpm --filter platform-desktop-app run renderer:build",
    "desktop:package:internal": "corepack pnpm --filter platform-desktop-app run package:internal",
    "desktop:package:public": "corepack pnpm --filter platform-desktop-app run package:public",
    "desktop:release:report": "corepack pnpm --filter platform-desktop-app run deploy:public:report",
    "desktop:doctor": "corepack pnpm --filter platform-desktop-app run doctor",
    "presentation:test:browser": "corepack pnpm --filter presentation-agent-browser-validation test:browser"
  }
}
