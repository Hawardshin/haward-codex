    {
      "id": "project_registry",
      "path": "_ops/projects/registry.json",
      "tier": "hot",
      "purpose": "Root project ownership and boundary registry.",
      "required": true,
      "load_order": 9
    },
    {
      "id": "platform_readme",
      "path": "agent-platform/README.md",
