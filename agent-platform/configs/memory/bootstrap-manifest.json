      "purpose": "Current dated work log and compressed context.",
      "required": true,
      "load_order": 25
    },
    {
      "id": "repository_map",
      "path": "_ops/maps/repository-map.md",
      "tier": "cold",
      "purpose": "Generated repository file index for targeted retrieval.",
