{
  "schema_version": "2026-05-31",
  "name": "workspace-memory-bootstrap",
  "purpose": "Defines durable memory anchors that an AI agent should load or know how to retrieve before working in this repository.",
  "hot_context_limit": 12,
  "default_command": "PYTHONPATH=src python3 -m agent_platform.cli check-memory-bootstrap configs/memory/bootstrap-manifest.json",
  "startup_sequence": [
    "repo_instructions",
    "persistent_instructions",
    "ops_index",
    "prompt_router",
    "start_workflow",
    "web_first_workflow",
    "memory_bootstrap_workflow",
    "coordination_board",
    "project_registry",
    "platform_readme",
    "source_registry",
    "coding_research_profile"
  ],
  "required_anchor_ids": [
    "repo_instructions",
    "persistent_instructions",
    "ops_index",
    "prompt_router",
    "start_workflow",
    "web_first_workflow",
    "memory_bootstrap_workflow",
    "coordination_board",
    "project_registry",
    "platform_readme",
    "source_registry",
    "coding_research_profile"
  ],
  "anchors": [
    {
      "id": "repo_instructions",
      "path": "AGENTS.md",
      "tier": "hot",
      "purpose": "Top-level repository rules that every agent should obey.",
      "required": true,
      "load_order": 1
    },
    {
      "id": "persistent_instructions",
      "path": "_docs/persistent-instructions.md",
      "tier": "hot",
      "purpose": "Durable user preferences and long-running operating rules.",
      "required": true,
      "load_order": 2
    },
    {
      "id": "ops_index",
      "path": "_ops/index.md",
      "tier": "hot",
      "purpose": "Navigation hub for operations, prompts, workflows, maps, projects, and coordination.",
      "required": true,
      "load_order": 3
    },
    {
      "id": "prompt_router",
      "path": "_ops/prompts/00-router.md",
      "tier": "hot",
      "purpose": "Prompt selection table for repeated task types.",
      "required": true,
      "load_order": 4
    },
    {
      "id": "start_workflow",
      "path": "_ops/workflows/00-start-here.md",
      "tier": "hot",
      "purpose": "Default work sequence for every non-trivial request.",
      "required": true,
      "load_order": 5
    },
    {
      "id": "web_first_workflow",
      "path": "_ops/workflows/05-web-first-intake.md",
      "tier": "hot",
      "purpose": "Required web-first intake for every new user instruction.",
      "required": true,
      "load_order": 6
    },
    {
      "id": "memory_bootstrap_workflow",
