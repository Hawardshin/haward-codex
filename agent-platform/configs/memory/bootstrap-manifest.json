    {
      "id": "prompt_map",
      "path": "_ops/maps/prompt-map.md",
      "tier": "cold",
      "purpose": "Generated prompt and workflow map.",
      "required": true,
      "load_order": 41
    }
  ],
  "refresh_rules": [
    "Run this manifest check after changing durable rules, operations navigation, source configs, prompt/workflow maps, or project boundaries.",
    "Keep hot anchors compact; move detailed context to warm or cold anchors.",
    "Update required anchors when a new setting becomes mandatory for every future session.",
    "If a hot anchor becomes stale or too large, split it and record the new path here."
  ]
}
