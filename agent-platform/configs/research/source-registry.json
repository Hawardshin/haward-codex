  "structure_rules": [
    {
      "id": "types_are_taxonomy_not_evidence",
      "rule": "source_types classify evidence; they do not by themselves prove a claim.",
      "reason": "Research still needs source-specific evaluation and grounding.",
      "applies_to": [
        "source_types"
      ]
    },
    {
      "id": "social_and_community_are_signals",
      "rule": "community and social sources are discovery, adoption, or pain-point signals unless backed by primary evidence.",
      "reason": "Popularity and reactions can reveal interest but do not establish correctness.",
      "applies_to": [
        "source_types",
        "reference_sources"
      ]
    },
    {
      "id": "every_reference_needs_use_case",
      "rule": "Each reusable reference must record what it is used for and when it was last checked.",
      "reason": "Future agents need to know why a link exists and whether it may be stale.",
      "applies_to": [
        "reference_links",
        "reference_sources"
      ]
    },
        {
            "id": "architecture_sources_shape_code_structure",
            "rule": "Architecture frameworks and reference architectures should be used to compare source-code structure options before implementation.",
      "reason": "The user requires source-code work to look for best architectures, not only examples of working code.",
      "applies_to": [
        "reference_sources",
                "coding-research-profile"
            ]
        },
        {
            "id": "enterprise_sources_are_seed_list",
            "rule": "Large-company engineering, research-lab, architecture-center, and high-signal source URLs live in enterprise-source-registry.json, while this file keeps source types and reusable taxonomy references.",
            "reason": "The user requested these high-quality site lists to be managed separately.",
            "applies_to": [
                "reference_links",
                "reference_sources",
                "enterprise-source-registry.json"
            ]
        },
        {
            "id": "quantitative_values_need_provenance",
            "rule": "Quantitative marketing, survey, market-size, and business-planning values must record source, unit, denominator, geography, timeframe, population, method, sponsor, and access date before being used as evidence.",
            "reason": "Numbers without context are easy to misuse in marketing plans and market sizing.",
            "applies_to": [
                "source_types",
                "marketing-evidence-profile.json"
            ]
        }
    ],
