  "source_types": [
    {
      "id": "official",
      "label_ko": "공식/1차 출처",
      "label_en": "Official or primary source",
      "examples": [
        "official documentation",
        "API reference",
        "release notes",
        "vendor engineering blog"
      ],
      "default_reliability": "high",
      "use_for": [
        "current behavior",
        "API contract",
        "supported configuration",
        "release status"
      ],
      "limits": [
        "May omit third-party trade-offs or failure cases."
      ]
    },
    {
      "id": "paper",
      "label_ko": "논문/학술 자료",
      "label_en": "Paper or academic source",
      "examples": [
        "journal article",
        "conference paper",
        "arXiv preprint"
      ],
      "default_reliability": "medium_high",
      "use_for": [
        "methodology",
        "empirical evidence",
        "known limitations"
      ],
      "limits": [
        "May be less current than implementation practice."
      ]
    },
    {
      "id": "book",
      "label_ko": "책/이론서",
      "label_en": "Book or theory source",
      "examples": [
        "marketing textbook",
        "strategy book",
        "publisher page",
        "library catalog record",
        "book metadata API"
      ],
      "default_reliability": "medium_high",
      "use_for": [
        "conceptual frameworks",
        "classic theory",
        "terminology",
        "bibliographic discovery"
      ],
      "limits": [
        "Not proof of current market size or current consumer behavior without fresh data."
      ]
    },
    {
      "id": "standard",
      "label_ko": "표준/규격",
      "label_en": "Standard or specification",
      "examples": [
        "RFC",
        "W3C specification",
        "ISO standard"
      ],
      "default_reliability": "high",
      "use_for": [
        "protocol requirements",
        "interoperability",
        "compliance-sensitive behavior"
      ],
      "limits": [
        "May not explain operational trade-offs."
      ]
    },
    {
      "id": "official_statistics",
      "label_ko": "공식 통계/공공 데이터",
      "label_en": "Official statistics or public dataset",
      "examples": [
        "national statistics office",
        "central bank dataset",
        "World Bank indicators",
        "OECD data",
        "census data"
      ],
      "default_reliability": "high",
      "use_for": [
        "population denominator",
        "macroeconomic context",
        "industry baseline",
        "regional market sizing"
      ],
      "limits": [
        "May not map exactly to the target buyer, category, or behavior being studied."
      ]
    },
    {
      "id": "survey_dataset",
      "label_ko": "설문/패널 데이터",
      "label_en": "Survey or panel dataset",
      "examples": [
        "Pew Research survey",
        "Gallup poll",
        "CMO Survey",
        "consumer panel report",
        "public opinion dataset"
      ],
      "default_reliability": "medium_high",
      "use_for": [
        "attitudes",
        "preferences",
        "awareness",
        "self-reported behavior",
        "marketing leader sentiment"
      ],
      "limits": [
        "Requires methodology disclosure including population, sample, mode, dates, weighting, sponsor, and question wording."
      ]
    },
    {
      "id": "open_source",
      "label_ko": "오픈소스 원천",
      "label_en": "Open-source source material",
      "examples": [
        "GitHub repository",
        "issue",
        "pull request",
        "release notes"
      ],
      "default_reliability": "medium_high",
      "use_for": [
        "actual implementation",
        "maintenance status",
        "license and adoption signals"
      ],
      "limits": [
        "Repository popularity does not prove technical correctness."
      ]
    },
    {
      "id": "reference_implementation",
      "label_ko": "참고 구현/실제 코드",
      "label_en": "Reference implementation or real source code",
      "examples": [
        "well-maintained repository source tree",
        "reference implementation",
        "example application",
        "test suite"
      ],
      "default_reliability": "medium_high",
      "use_for": [
        "project structure",
        "module boundaries",
        "API usage patterns",
        "error handling",
        "test design"
      ],
      "limits": [
        "Do not copy blindly; verify license, fit, maintenance state, and local constraints."
      ]
    },
    {
      "id": "tech_blog",
      "label_ko": "기술 블로그/실무 사례",
      "label_en": "Technical blog or field case",
      "examples": [
        "engineering blog",
        "incident review",
        "benchmark write-up"
      ],
      "default_reliability": "medium",
      "use_for": [
        "field constraints",
        "migration stories",
        "trade-offs"
      ],
      "limits": [
        "Claims need confirmation from primary or independent sources."
      ]
    },
    {
      "id": "analysis",
      "label_ko": "분석/조사 아티클",
      "label_en": "Analysis or survey article",
      "examples": [
        "industry report",
        "benchmark comparison",
        "long-form analysis"
      ],
      "default_reliability": "medium",
      "use_for": [
        "comparison",
        "market context",
        "trend discovery"
      ],
      "limits": [
        "Check methodology and sponsorship."
      ]
    },
    {
      "id": "market_report",
      "label_ko": "시장/산업 리포트",
      "label_en": "Market or industry report",
      "examples": [
        "industry benchmark report",
        "consulting report",
        "vendor state-of report",
        "market research firm report",
        "CMO trend report"
      ],
      "default_reliability": "medium",
      "use_for": [
        "current market context",
        "category benchmarks",
        "ad spend",
        "consumer trend estimates",
        "competitive context"
      ],
      "limits": [
        "Check sponsor, business model, methodology disclosure, sample, and paywall limitations before using as factual evidence."
      ]
    },
    {
      "id": "community",
      "label_ko": "커뮤니티 신호",
      "label_en": "Community signal",
      "examples": [
        "Stack Overflow",
        "Hacker News",
        "Reddit",
        "GitHub discussion"
      ],
      "default_reliability": "low_medium",
      "use_for": [
        "pain points",
        "adoption signal",
        "edge cases"
      ],
      "limits": [
        "Not standalone proof."
      ]
    },
    {
      "id": "news",
      "label_ko": "뉴스/현재 동향",
      "label_en": "News or current-events source",
      "examples": [
        "technology news article",
        "security news",
        "market update"
      ],
      "default_reliability": "medium",
      "use_for": [
        "recent changes",
        "ecosystem movement",
        "incident discovery"
      ],
      "limits": [
        "Needs confirmation from primary sources before implementation decisions."
      ]
    },
    {
      "id": "social",
      "label_ko": "소셜/전문가 신호",
      "label_en": "Social or expert signal",
      "examples": [
        "LinkedIn post",
        "conference talk",
        "newsletter"
      ],
      "default_reliability": "low_medium",
      "use_for": [
        "expert attention",
        "practitioner reaction",
        "discovery"
      ],
      "limits": [
        "Must be backed by primary sources before factual use."
      ]
    },
    {
      "id": "contrary",
      "label_ko": "반대/실패 사례",
      "label_en": "Contrary or failure case",
      "examples": [
        "negative migration report",
        "security advisory",
        "postmortem",
        "deprecation warning"
      ],
      "default_reliability": "medium",
      "use_for": [
        "risk discovery",
        "decision reversal checks",
        "failure modes"
      ],
      "limits": [
        "May be context-specific."
      ]
    },
    {
      "id": "internal",
      "label_ko": "내부 지식 베이스",
      "label_en": "Internal knowledge base",
      "examples": [
        "_docs/",
        "_research/",
        "_history/",
        "project docs"
      ],
      "default_reliability": "medium",
      "use_for": [
        "workspace rules",
        "prior decisions",
        "local context"
      ],
      "limits": [
        "Must pass knowledge-skeptic-agent before use as evidence."
      ]
    }
  ],
