  "name": "source-registry",
  "purpose": "Canonical registry of source types and reusable reference sources for coding and technical research.",
  "reader_guide": {
    "summary": "This file explains which source categories the workspace recognizes, which reference links shaped those categories, and how each source type should be used or limited.",
    "how_to_read": [
      "Read source_types to understand the taxonomy used in research reports.",
      "Read reference_links to see the external and internal references behind this taxonomy.",
      "Read structure_rules before adding a new source type or reference source.",
      "Use reference_sources as reusable known references for future research tasks."
    ],
    "owner": "agent-platform",
    "last_reviewed": "2026-05-31",
    "update_triggers": [
      "A new source type is needed for repeated research.",
      "A reference source becomes stale, unavailable, or contradicted.",
      "A coding research profile changes its required source coverage.",
      "A source category starts being misused as proof instead of signal."
    ]
  },
