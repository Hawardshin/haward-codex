{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Workspace Platform",
  "version": "0.1.0",
  "identifier": "com.personalagentplatform.desktop",
  "build": {
    "beforeBuildCommand": "corepack pnpm run renderer:build",
    "beforeDevCommand": "corepack pnpm --dir ../renderer/workspace-monitor run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../renderer/workspace-monitor/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Workspace Platform",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "resources": {
      "../runtime-contracts/installer-shell-runtime-contract.json": "runtime-contracts/installer-shell-runtime-contract.json",
      "../runtime-contracts/installer-shell-bootstrap.ko.md": "runtime-contracts/installer-shell-bootstrap.ko.md",
      "../runtime-contracts/installer-shell-bootstrap.en.md": "runtime-contracts/installer-shell-bootstrap.en.md"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Installable shell for a personal agent-building platform.",
    "longDescription": "A local desktop shell for browsing workspace history, documents, agents, requirements, specs, and future optional AI coding CLI capabilities.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
