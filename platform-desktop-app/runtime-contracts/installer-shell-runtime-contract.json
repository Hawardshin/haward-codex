{
  "schema_version": "2026-06-03",
  "name": "installer-shell-runtime-contract",
  "purpose": "Defines the source-of-truth contract that the installed desktop app shell/runtime must read before launching or supervising platform work. The contract turns this repository from loose project knowledge into enforceable runtime instructions, gates, and data accumulation targets.",
  "reader_guide": {
    "summary": "Read this contract when adding installer shell behavior, runtime shell commands, CLI adapters, task orchestration, data accumulation, or enforcement gates.",
    "how_to_read": [
      "Start with installer_shell_contract to understand which runtime owns the work.",
      "Use shell_boot_sequence to know what the installed shell must load before task execution.",
      "Use required_read_targets to decide which repository documents/configs become shell-readable product contracts.",
      "Use enforcement_gates to keep task execution from bypassing required policy, privacy, validation, or evaluation steps.",
      "Use data_accumulation_targets to decide where structured task records, decisions, logs, evidence, and evaluations must be written."
    ],
    "owner": "platform-desktop-app",
      "last_reviewed": "2026-06-04",
    "update_triggers": [
      "The installed shell launches, supervises, or bundles a new runtime.",
      "A runtime command, CLI adapter, sidecar, task pipeline, or shell process is added.",
      "A new task record, decision, log, support bundle, or evidence store is introduced.",
      "A policy, workflow, or config becomes mandatory for installed-shell execution.",
      "Installer bundle resources, runtime data roots, or customer visibility boundaries change."
    ]
  },
