  "structure_rules": [
    {
      "id": "platform_first_shell_runtime",
      "rule": "The installed app shell launches first and owns task state, durable memory, decisions, artifacts, validation, and UI authority; external AI CLIs run only as guest adapter lanes.",
      "reason": "The product must not become a wrapper around one external CLI.",
      "applies_to": [
        "installer_shell_contract",
        "shell_boot_sequence",
        "runtime_command_surface"
      ]
    },
    {
      "id": "contract_is_bundled_and_checked",
      "rule": "The installer shell runtime contract must be bundled as a Tauri resource and validated by `scripts/check-runtime-contract.mjs` in the default `check` chain.",
      "reason": "A contract that is not shipped and checked cannot constrain the installed shell.",
      "applies_to": [
        "bundle_resource_targets",
        "validation"
      ]
    },
    {
      "id": "shell_reads_before_work",
      "rule": "Before task execution, the shell must load the runtime contract, runtime data boundary, CLI adapter registry, and applicable workflow gates.",
      "reason": "Task behavior should come from durable project contracts, not chat memory or ad hoc UI state.",
      "applies_to": [
        "shell_boot_sequence",
        "required_read_targets"
      ]
    },
    {
      "id": "runtime_data_accumulates_structured_records",
      "rule": "Task output, decisions, logs, validation, and evidence must be accumulated as structured records with provenance, retention posture, review gates, and a user-visible accumulated data index.",
      "reason": "The platform value is durable accumulated operating data, not only temporary shell output.",
      "applies_to": [
        "data_accumulation_targets",
        "runtime_command_surface",
        "enforcement_gates"
      ]
    },
    {
      "id": "accumulated_data_index_uses_versioned_manifest",
      "rule": "User-visible accumulated data reads must be backed by a versioned index manifest at `app_data/runtime-data/indexes/accumulated-data-overview.v1.json`; raw store scans may refresh the manifest but must not be the only user-facing storage format.",
      "reason": "The desktop product needs a stable local data artifact that can be migrated, audited, and read by the installed shell.",
      "applies_to": [
        "data_accumulation_targets",
        "runtime_command_surface"
      ]
    },
    {
      "id": "workspace_host_owns_clone_and_selection",
      "rule": "The desktop app must own workspace import, repository clone, active workspace selection, and workspace state persistence through app-data workspace host commands instead of requiring users to manually clone a repository and run tools from that clone.",
      "reason": "End users should operate through the installed app, while Git remains an optional capability invoked behind bounded app commands.",
      "applies_to": [
        "runtime_command_surface",
        "shell_boot_sequence",
        "enforcement_gates"
      ]
    },
    {
      "id": "private_and_output_dirs_are_not_runtime_knowledge",
      "rule": "The shell must not recursively read, index, summarize, or bundle `_private/` or `outputs/` by default.",
      "reason": "Local-only private and transient folders are not durable product knowledge sources.",
      "applies_to": [
        "denied_read_targets",
        "installer_payload_policy"
      ]
    }
  ],
  "field_guide": [
    {
      "field": "installer_shell_contract",
      "meaning": "Ownership and launch model for the installed app shell/runtime.",
      "required": true
    },
    {
      "field": "bundle_resource_targets",
      "meaning": "Files that must be bundled into the installed app as shell-readable Tauri resources.",
      "required": true
    },
    {
      "field": "required_read_targets",
      "meaning": "Repository contracts and workflow files the shell must load or mirror before executing platform work.",
      "required": true
    },
    {
      "field": "shell_boot_sequence",
      "meaning": "Ordered startup and task-execution sequence for installed-shell work.",
      "required": true
    },
    {
      "field": "enforcement_gates",
      "meaning": "Mandatory gates that prevent work from bypassing policy, privacy, validation, or evaluation.",
      "required": true
    },
    {
      "field": "data_accumulation_targets",
      "meaning": "Structured stores where shell/runtime work must accumulate reusable task, decision, evidence, log, and evaluation records.",
      "required": true
    }
  ],
  "installer_shell_contract": {
    "launch_model": "installed_app_owns_shell_runtime",
    "host_runtime": "Tauri v2 Rust backend with workspace-monitor UI",
    "shell_role": "primary_platform_host",
    "external_cli_role": "optional_guest_adapter_lane",
    "current_execution_model": "Rust/Tauri command surface with allowlisted external CLI process lanes; shell plugin sidecars require a separate capability and installation audit before use.",
    "must_read_contract_before_work": true,
    "must_write_structured_accumulation_records": true,
    "missing_cli_behavior": "capability_missing",
