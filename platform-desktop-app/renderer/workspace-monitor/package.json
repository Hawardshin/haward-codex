{
  "name": "workspace-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Vercel-ready Next.js monitoring site for the platform-first agent workspace.",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "next dev",
    "collect": "node scripts/collect-workspace.mjs",
    "install:browsers": "playwright install chromium --only-shell",
    "prebuild": "node scripts/collect-workspace.mjs --best-effort",
    "build": "next build",
    "build:customer": "node scripts/collect-workspace.mjs --best-effort --snapshot-mode customer && next build",
    "check": "tsc --noEmit && node scripts/check-scroll-containers.mjs && node scripts/check-source-control-design.mjs && node scripts/check-history-payload.mjs",
    "check:scroll-containers": "node scripts/check-scroll-containers.mjs",
    "check:source-control-design": "node scripts/check-source-control-design.mjs",
    "check:history-payload": "node scripts/check-history-payload.mjs",
    "check:intent-map": "node scripts/check-intent-feature-map.mjs --snapshot generated --expect developer",
    "check:intent-map:customer": "node scripts/check-intent-feature-map.mjs --snapshot public --expect customer",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "perf:buttons": "node scripts/audit-button-response.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "dompurify": "3.4.7",
    "postcss": "8.5.10"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.4",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "lucide-react": "1.17.0",
    "monaco-editor": "0.55.1",
    "next": "16.2.6",
    "pretendard": "1.3.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "typescript": "6.0.3"
  }
}
