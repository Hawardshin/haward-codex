  ],
  "structure_rules": [
    {
      "id": "clone_before_implementation",
      "rule": "Before implementing an open-source-inspired feature, clone and inspect at least two relevant candidate repositories unless the feature is purely presentational.",
      "reason": "Search snippets are discovery signals, not implementation evidence.",
      "applies_to": [
        "feature_reference_layers",
        "candidate_repos",
        "implementation_targets"
      ]
    },
    {
      "id": "install_only_when_needed",
      "rule": "Do not install a dependency just because a reference project uses it; install only when the current feature cannot be implemented cleanly with existing platform dependencies.",
      "reason": "The desktop app already carries runtime, UI, and packaging complexity.",
      "applies_to": [
        "install_policy",
        "install_needed_now",
        "candidate_repos"
      ]
    },
    {
      "id": "record_install_audit",
      "rule": "Any new package, CLI, MCP server, or global tool install needs an installation audit, license/security review, verification command, and rollback plan.",
      "reason": "Open-source reuse must stay auditable and reversible.",
      "applies_to": [
        "install_policy",
        "install_needed_now",
        "_history/installations"
      ]
    }
  ],
  "field_guide": [
    {
      "field": "feature_id",
      "meaning": "Matches product-feature-registry feature layer ids where possible.",
      "required": true
    },
    {
      "field": "priority",
      "meaning": "p0 is next implementation reference, p1 is near-term, p2 is background research.",
      "required": true
    },
    {
      "field": "install_policy",
      "meaning": "Declares whether a new dependency is currently needed and what audit boundary applies.",
      "required": true
    },
    {
      "field": "candidate_repos",
      "meaning": "Directly inspectable GitHub repositories or strong official project references.",
      "required": true
    },
    {
      "field": "verified_by",
      "meaning": "How the repository existence or source was checked in this research pass.",
      "required": true
    },
    {
      "field": "watch_targets",
      "meaning": "Files, folders, or product behavior to inspect after cloning.",
      "required": true
    },
    {
      "field": "patterns_to_extract",
      "meaning": "Reference patterns that may be transferred into this platform.",
      "required": true
    }
  ],
  "source_boundary": {
    "policy": "public_sources_only",
    "customer_visibility": "summary_allowed",
    "excluded_sources": [
      "private repos",
      "leaked source",
      "screenshots without source provenance",
      "license-incompatible source copy"
    ],
    "accepted_source_types": [
      "official GitHub repository",
      "official documentation",
      "internal research record",
      "direct local clone inspection"
    ]
  },
