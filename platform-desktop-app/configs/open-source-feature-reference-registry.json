{
  "schema_version": "2026-06-06",
  "name": "open-source-feature-reference-registry",
  "purpose": "Maps each desktop product feature layer to directly inspectable open-source references before implementation. This keeps open-source research actionable inside the app instead of buried in notes.",
  "reader_guide": {
    "summary": "Use this registry before implementing a feature slice inspired by external open-source platforms.",
    "how_to_read": [
      "Start with feature_reference_layers and pick the current feature layer.",
      "Read candidate_repos to decide which repositories should be cloned and inspected before implementation.",
      "Use implementation_targets to connect external patterns to current platform surfaces.",
      "Use install_policy before adding dependencies or auto-installing optional tools."
    ],
    "owner": "platform-desktop-app",
    "last_reviewed": "2026-06-06",
    "update_triggers": [
      "A feature slice moves from research to implementation.",
      "A new external open-source reference becomes a stronger fit.",
      "A dependency, CLI adapter, MCP server, or package installation is proposed.",
      "An existing reference becomes archived, unavailable, or legally risky."
    ]
  },
  "reference_links": [
