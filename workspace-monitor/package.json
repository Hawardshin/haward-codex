{
  "name": "workspace-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Vercel-ready Next.js monitoring site for the Codex workspace repository.",
  "scripts": {
    "dev": "next dev",
    "collect": "node scripts/collect-workspace.mjs",
    "prebuild": "node scripts/collect-workspace.mjs --best-effort",
    "build": "next build",
    "check": "tsc --noEmit",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "dependencies": {
    "lucide-react": "1.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
