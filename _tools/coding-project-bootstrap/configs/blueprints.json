{
  "schema_version": "2026-06-01",
  "name": "coding-project-bootstrap-blueprints",
  "purpose": "Defines safe, minimal, technology-aware starter structures for new coding projects in this workspace.",
  "reader_guide": {
    "summary": "Use this file when creating a new coding project. It separates the durable workspace contract from technology-specific starter choices so new projects stay isolated while still inheriting the platform's research, spec, history, and evaluation loop.",
    "how_to_read": [
      "Read structure_rules before adding or changing a blueprint.",
      "Use field_guide to understand required blueprint fields.",
      "Pick a blueprint by matching the intended runtime and maintenance style, not by copying all possible framework files.",
      "Run the coding-project-bootstrap tool in dry-run mode before applying changes.",
      "After applying, run structure-audit and workspace-health so the management platform can see the new project."
    ],
    "owner": "_tools/coding-project-bootstrap",
    "last_reviewed": "2026-06-01",
    "update_triggers": [
      "A new technology stack becomes a repeated project type.",
      "A generated project folder contract changes.",
      "A blueprint starts requiring dependency installation.",
      "Project registry fields or workspace structure rules change.",
      "External official docs or generator practices change."
    ]
  },
