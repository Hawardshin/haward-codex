  "structure_rules": [
    {
      "id": "dry_run_first",
      "rule": "The tool should produce a dry-run plan by default; filesystem changes require an explicit apply flag.",
      "reason": "The user is concerned about waste and accidental project sprawl.",
      "applies_to": [
        "tool_cli",
        "blueprints"
      ]
    },
    {
      "id": "minimal_stack_contract",
      "rule": "Blueprints should create a durable project contract and minimal stack-specific paths, not a full dependency tree or generated framework cache.",
      "reason": "Framework installers can become stale, heavy, or install dependencies before the project intent is confirmed.",
      "applies_to": [
        "blueprints.files",
        "blueprints.directories"
      ]
    },
    {
      "id": "registry_is_optional_but_preferred",
      "rule": "Root-level project creation should support project registry updates, but custom target locations must not be auto-registered as root projects.",
      "reason": "Root projects need lifecycle visibility, while nested modules may belong to an existing project.",
      "applies_to": [
        "tool_cli",
        "_ops/projects/registry.json"
      ]
    },
    {
      "id": "official_docs_before_implementation",
      "rule": "Each blueprint must list official documentation or standards to check before source-code implementation.",
      "reason": "The bootstrap only creates a starting boundary; implementation decisions still require current stack research.",
      "applies_to": [
        "blueprints.official_docs"
      ]
    },
    {
      "id": "project_local_extensions",
      "rule": "Project-specific tools, configs, docs, tests, assets, and artifacts created after bootstrap belong inside the generated project unless they are promoted as shared capabilities.",
      "reason": "This keeps each coding project isolated while still allowing reusable tools to live under _tools.",
      "applies_to": [
        "blueprints.project_specific_home",
        "blueprints.boundary_notes"
      ]
    }
  ],
  "field_guide": [
    {
      "field": "blueprints.id",
      "meaning": "Stable command-line ID for selecting the blueprint.",
      "required": true
    },
    {
      "field": "blueprints.label",
      "meaning": "Human-readable blueprint name.",
      "required": true
    },
    {
      "field": "blueprints.registry_type",
      "meaning": "Project type written to _ops/projects/registry.json when --register is used.",
      "required": true
    },
    {
      "field": "blueprints.official_docs",
      "meaning": "Official docs or standards that must be rechecked before implementation work.",
      "required": true
    },
    {
      "field": "blueprints.directories",
      "meaning": "Project-local directories created for this stack.",
      "required": true
    },
    {
      "field": "blueprints.files",
      "meaning": "Minimal stack-specific starter files rendered with project variables.",
      "required": true
    },
    {
      "field": "blueprints.project_specific_home",
      "meaning": "Durable top-level folders to register for root project visibility.",
      "required": true
    }
  ],
  "common_directories": [
    "artifacts",
    "configs",
    "docs",
    "docs/architecture",
    "docs/decisions",
    "docs/requirements",
    "docs/research",
    "specs",
