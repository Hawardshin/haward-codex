    "_history/",
    "_requirements/",
    "_specs/",
    "_tools/coding-project-bootstrap/",
    "agent-platform/configs/research/coding-research-profile.json"
  ],
  "common_boundary_notes": [
    "Keep project-specific source, docs, tests, configs, artifacts, and helper tools inside this project folder.",
    "Use shared workspace folders only for reusable capabilities that serve multiple projects.",
    "Before source-code implementation, run coding research for the selected stack and record language, architecture, folder, and official-doc decisions."
  ],
